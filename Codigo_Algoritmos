    // Método para agregar un proceso ingresado por el usuario a la lista y actualizar la tabla de cola
    private void agregarProceso() {
        try {
            String nombre = txtNombre.getText().trim();
            int tiempoCPU = Integer.parseInt(txtTiempoCPU.getText().trim());
            int instanteLlegada = Integer.parseInt(txtLlegada.getText().trim());
            int quantum = 0;
            if(txtQuantum.isEnabled()) {
                quantum = Integer.parseInt(txtQuantum.getText().trim());
            }
            // Validar entradas: no vacías ni valores negativos o cero cuando no permitido
            if(nombre.isEmpty() || tiempoCPU<=0 || instanteLlegada<0 || (txtQuantum.isEnabled() && quantum<=0)) {
                JOptionPane.showMessageDialog(this, "Ingrese valores válidos", "Error de Entrada", JOptionPane.ERROR_MESSAGE);
                return;
            }
            // Confirmar desde cuadro de diálogo si desea agregar el proceso
            int confirm = JOptionPane.showConfirmDialog(this, "¿Desea agregar el proceso '"+nombre+"'?", "Confirmación", JOptionPane.YES_NO_OPTION);
            if(confirm == JOptionPane.NO_OPTION) return;

            // Crear proceso con nuevo PID y agregarlo a la lista
            Proceso p = new Proceso(nextPID++, nombre, tiempoCPU, instanteLlegada, quantum);
            procesos.add(p);
            limpiarCampos(); // Limpia campos de entrada
            actualizarTablaCola(); // Actualiza visualización en tabla de cola
            estadoLabel.setText("Estado: Proceso '" + nombre + "' agregado correctamente");
        } catch(NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Ingrese solo números enteros en campos numéricos", "Error de Formato", JOptionPane.ERROR_MESSAGE);
        }
    }

    // Limpia los campos de texto para un nuevo ingreso
    private void limpiarCampos() {
        txtNombre.setText("");
        txtTiempoCPU.setText("");
        txtLlegada.setText("");
        txtQuantum.setText("");
    }

    // Actualiza la tabla de cola con los procesos almacenados
    private void actualizarTablaCola() {
        modeloCola.setRowCount(0);
        for(Proceso p: procesos) {
            String quantumDisplay = p.quantum > 0 ? String.valueOf(p.quantum) : "-";
            modeloCola.addRow(new Object[]{p.pid, p.nombre, p.tiempoCPU, p.instanteLlegada, quantumDisplay});
        }
    }

    // Método para iniciar la simulación según algoritmo seleccionado
    private void iniciarSimulacion() {
        String algoritmo = (String) algoritmoCombo.getSelectedItem();
        if(procesos.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Agregue al menos un proceso para iniciar la simulación.", "Error de Inicio", JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        // Deshabilitar botones y combo para evitar modificación mientras la simulación está en progreso
        btnIniciarSimulacion.setEnabled(false);
        btnAgregarProceso.setEnabled(false);
        btnLimpiarHistorial.setEnabled(false);
        algoritmoCombo.setEnabled(false);
        
        // Limpiar tablas de simulación y resultados
        modeloSimulacion.setRowCount(0);
        modeloResultados.setRowCount(0);
        tiempoMaximoSimulacion = 0;
        
        estadoLabel.setText("Estado: Simulación en progreso...");
        
        // Mostrar etiqueta especial para cola Round Robin, si aplica
        if ("Round Robin".equals(algoritmo)) {
            colaRRLabel.setText("Cola RR: Iniciando...");
            colaRRLabel.setVisible(true);
        } else {
            colaRRLabel.setVisible(false);
        }

        // Crear copia separada de procesos para no modificar los originales durante simulación
        List<Proceso> procesosSimulacion = new ArrayList<>();
        for(Proceso p: procesos) procesosSimulacion.add(new Proceso(p));
        // Ordenar la lista de procesos por instante de llegada ascendente
        procesosSimulacion.sort(Comparator.comparingInt(p -> p.instanteLlegada));
        
        // Inicializar tabla que muestra la simulación tiempo por tiempo
        inicializarTablaSimulacion(procesosSimulacion);
        
        // Crear hilo simulador que ejecuta la simulación en segundo plano
        Simulador simulador = new Simulador(procesosSimulacion, algoritmo);
        simulador.start();
    }
    
    // Inicializa la tabla de simulación con las filas de los procesos y columnas por unidad de tiempo
    private void inicializarTablaSimulacion(List<Proceso> procesos) {
        // Calcular tiempo máximo estimado para la simulación sumando tiempo CPU + llegada de cada proceso
        tiempoMaximoSimulacion = procesos.stream().mapToInt(p -> p.tiempoCPU + p.instanteLlegada).sum();
        tiempoMaximoSimulacion = Math.max(tiempoMaximoSimulacion, 20); // Mínimo 20 unidades para perspectiva visual
        
        // Crear encabezados con números de tiempo desde 0 hasta tiempo máximo
        Vector<String> columnNames = new Vector<>();
        columnNames.add("Proceso");
        for (int i = 0; i <= tiempoMaximoSimulacion; i++) {
            columnNames.add(String.valueOf(i));
        }
        
        modeloSimulacion.setColumnIdentifiers(columnNames);
        
        // Agregar filas para cada proceso con marcadores "L" en el instante de llegada
        for (Proceso p : procesos) {
            Vector<Object> row = new Vector<>();
            row.add(p.nombre);
            for (int i = 0; i <= tiempoMaximoSimulacion; i++) {
                if (i == p.instanteLlegada) {
                    row.add("L"); // Indicar llegada
                } else {
                    row.add("");
                }
            }
            modeloSimulacion.addRow(row);
        }
    }
    
    // Actualiza la tabla de simulación para marcar una ejecución "X" en el tiempo actual para el proceso que corre
    private void actualizarTablaSimulacion(int tiempoActual, String procesoEjecutando) {
        SwingUtilities.invokeLater(() -> {
            if (tiempoActual <= tiempoMaximoSimulacion) {
                // Por cada fila, si es el proceso que se ejecuta, marca "X" en la columna del tiempo actual +1 (columna 0 es nombre)
                for (int row = 0; row < modeloSimulacion.getRowCount(); row++) {
                    String proceso = modeloSimulacion.getValueAt(row, 0).toString();
                    if (proceso.equals(procesoEjecutando)) {
                        modeloSimulacion.setValueAt("X", row, tiempoActual + 1);
                    }
                }
                
                // Hacer scroll automático hacia la columna del tiempo actual para mejor visualización
                if (tiempoActual + 1 < tablaSimulacionTable.getColumnCount()) {
                    tablaSimulacionTable.scrollRectToVisible(
                        tablaSimulacionTable.getCellRect(0, tiempoActual + 1, true)
                    );
                }
            }
        });
    }
    
    // Mostrar los resultados finales calculados en la tabla de resultados, incluyendo tiempos y índices de servicio
    private void mostrarResultadosEnTabla(List<Proceso> resultados, int tiempoSistemaFinal, String algoritmo, String secuenciaEjecucion) {
        SwingUtilities.invokeLater(() -> {
            modeloResultados.setRowCount(0);
            
            double totalIndiceServicio = 0;
            resultados.sort(Comparator.comparingInt(p -> p.pid));

            // Para cada proceso calcular tiempo retorno, espera e índice servicio y cargar en tabla
            for(Proceso p : resultados) {
                p.tiempoRetorno = p.tiempoFinalizacion - p.instanteLlegada;
                p.tiempoEspera = p.tiempoRetorno - p.tiempoCPU;
                double indiceServicio = (p.tiempoRetorno > 0) ? (double)p.tiempoCPU / p.tiempoRetorno : 0.0;
                totalIndiceServicio += indiceServicio;
                
                modeloResultados.addRow(new Object[]{
                    p.nombre + " (" + p.pid + ")", 
                    p.instanteLlegada,
                    p.tiempoCPU,
                    p.tiempoFinalizacion, 
                    p.tiempoRetorno, 
                    p.tiempoEspera,
                    String.format("%.2f", indiceServicio)
                });
            }
            
            // Agregar fila con promedio del índice de servicio al final si hay resultados
            if(!resultados.isEmpty()) {
                double avgIndiceServicio = totalIndiceServicio / resultados.size();
                modeloResultados.addRow(new Object[]{
                    "PROMEDIO:", 
                    "", 
                    "", 
                    "", 
                    "", 
                    "", 
                    String.format("%.2f", avgIndiceServicio) 
                });
            }
            
            // Reactivar los botones y combo box para permitir nueva interacción tras finalizar la simulación
            btnIniciarSimulacion.setEnabled(true);
            btnAgregarProceso.setEnabled(true);
            btnLimpiarHistorial.setEnabled(true);
            algoritmoCombo.setEnabled(true);

            estadoLabel.setText("Estado: Simulación completada. Tiempo total: " + tiempoSistemaFinal + " unidades");

            // Mostrar u ocultar etiqueta cola RR según algoritmo seleccionado
            String currentAlg = (String) algoritmoCombo.getSelectedItem();
            colaRRLabel.setVisible("Round Robin".equals(currentAlg));
        });
    }
    
    // Clase interna Simulador que ejecuta la simulación en un hilo aparte para evitar bloquear la interfaz
    private class Simulador extends Thread {
        private List<Proceso> listaProcesos; // Procesos por ejecutar (ordenados y copiables)
        private String algoritmo; // Algoritmo seleccionado
        private int tiempoSistema = 0; // Tiempo virtual del sistema
        private List<Proceso> historial = new ArrayList<>(); // Historial de procesos finalizados
        private StringBuilder secuenciaEjecucion = new StringBuilder(); // Para registrar secuencia de ejecución
        
        public Simulador(List<Proceso> procesos, String algoritmo) {
            listaProcesos = procesos; 
            this.algoritmo = algoritmo;
        }

        @Override
        public void run() {
            List<Proceso> colaListos = new LinkedList<>(); // Cola de procesos listos para ejecutar
            
            // Mover procesos que ya llegaron a cola de listos
            moverLlegados(colaListos);

            while (!colaListos.isEmpty() || !listaProcesos.isEmpty()) {
                
                if (colaListos.isEmpty()) {
                    // Si cola vacía, avanzar el tiempo hasta que alguno llegue
                    tiempoSistema++;
                    try { Thread.sleep(TIEMPO_UNIDAD_MS);} catch (Exception ex) {}
                    moverLlegados(colaListos); 
                    continue;
                }
                
                // Actualizar etiqueta cola RR solo si es algoritmo Round Robin
                if ("Round Robin".equals(algoritmo)) {
                    actualizarColaRRLabel(colaListos); 
                }

                Proceso actual = null;

                switch (algoritmo) {
                    case "FCFS":
                    case "SJF": 
                        // Para SJF ordenar cola por tiempo restante (tiempoCPU - ejecutado)
                        if (algoritmo.equals("SJF")) {
                            colaListos.sort(Comparator.comparingInt(p -> p.tiempoCPU - p.tiempoEjecutado));
                        }
                        actual = colaListos.get(0);
                        // Registrar proceso en secuencia de ejecución para mostrar trace final
                        secuenciaEjecucion.append(actual.nombre).append(" "); 
                        
                        // Actualizar tabla simulación para mostrar ejecución actual
                        actualizarTablaSimulacion(tiempoSistema, actual.nombre);
                        
                        // Ejecutar proceso sin interrupción por su tiempo restante
                        runProcesoNoPreemptivo(actual, colaListos, historial, actual.tiempoCPU - actual.tiempoEjecutado); 
                        break;
                        
                    case "Round Robin":
                        actual = colaListos.get(0);

                        int restanteCPU = actual.tiempoCPU - actual.tiempoEjecutado;
                        int stepMax = Math.min(actual.quantum, restanteCPU);
                        
                        // Registrar proceso en secuencia
                        secuenciaEjecucion.append(actual.nombre).append(" "); 

                        for (int u = 0; u < stepMax; u++) {
                            // Actualizar simulación por unidad de tiempo
                            actualizarTablaSimulacion(tiempoSistema, actual.nombre);
                            
                            actual.tiempoEjecutado++;
                            tiempoSistema++; 
                            try { Thread.sleep(TIEMPO_UNIDAD_MS); } catch (Exception ex) {}

                            moverLlegados(colaListos);
                            actualizarColaRRLabel(colaListos); 

                            if (actual.tiempoEjecutado >= actual.tiempoCPU) break;
                        }

                        if (actual.tiempoEjecutado >= actual.tiempoCPU) {
                            // Proceso terminado: eliminar de cola y guardar en historial
                            colaListos.remove(0); 
                            historial.add(actual);
                            actual.tiempoFinalizacion = tiempoSistema;
                        } else {
                            // Si no terminó, mover al final de la cola para Round Robin
                            colaListos.remove(0);
                            colaListos.add(actual);
                        }
                        break;
                }

                // Actualizar tablas de cola y de historial con estado actual
                actualizarTablaColaSim(colaListos);
                actualizarTablaHistorial(historial);
            }

            String traceFinal = secuenciaEjecucion.toString().trim();
            
            // Al finalizar simulación, limpiar y actualizar etiqueta de cola RR
            SwingUtilities.invokeLater(() -> {
                colaRRLabel.setText("Cola RR: Simulación Finalizada"); 
                if (!"Round Robin".equals(algoritmo)) {
                    colaRRLabel.setVisible(false);
                }
            });

            // Mostrar resultados finales en la tabla de resultados
            mostrarResultadosEnTabla(historial, tiempoSistema, algoritmo, traceFinal); 
        }
        
        // Actualiza la etiqueta que muestra el estado actual de la cola en Round Robin
        private void actualizarColaRRLabel(List<Proceso> cola) {
            SwingUtilities.invokeLater(() -> {
                if (cola.isEmpty()) {
                    colaRRLabel.setText("Cola RR (t=" + tiempoSistema + "): Vacía");
                    return;
                }
                
                StringBuilder sb = new StringBuilder("Cola RR (t=" + tiempoSistema + "): ");
                for(Proceso p : cola) {
                    sb.append(p.nombre).append(" (").append(p.tiempoCPU - p.tiempoEjecutado).append("), ");
                }
                
                if (sb.length() > 0 && sb.toString().endsWith(", ")) {
                    sb.setLength(sb.length() - 2); 
                }
                
                colaRRLabel.setText(sb.toString());
            });
        }

        // Mueve procesos que ya han llegado al instante actual a la cola de listos
        private void moverLlegados(List<Proceso> colaListos) {
            Iterator<Proceso> it = listaProcesos.iterator();
            while (it.hasNext()) {
                Proceso p = it.next();
                if (p.instanteLlegada <= tiempoSistema) {
                    colaListos.add(p);
                    it.remove(); // Eliminar de lista de procesos pendientes
                }
            }
        }

        // Ejecuta un proceso no preemptivo (sin pausas) durante tiempoEjecutar unidades, actualizando estado y tabla simulación
        private void runProcesoNoPreemptivo(Proceso p, List<Proceso> cola, List<Proceso> hist, int tiempoEjecutar) {
            for(int i=0;i<tiempoEjecutar;i++) {
                actualizarTablaSimulacion(tiempoSistema, p.nombre);
                
                p.tiempoEjecutado++;
                tiempoSistema++; 
                try { Thread.sleep(TIEMPO_UNIDAD_MS);} catch(Exception ex) {}

                moverLlegados(cola);
            }
            
            // Cuando termina, eliminar de cola y agregar a historial marcando tiempo finalización
            if(p.tiempoEjecutado >= p.tiempoCPU) {
                cola.remove(p);
                hist.add(p);
                p.tiempoFinalizacion = tiempoSistema; 
            } 
        }

        // Actualiza la tabla de cola de procesos listos con sus datos actuales
        private void actualizarTablaColaSim(List<Proceso> cola) {
            SwingUtilities.invokeLater(() -> {
                modeloCola.setRowCount(0);
                for(Proceso p: cola) {
                    String quantumDisplay = p.quantum > 0 ? String.valueOf(p.quantum) : "-";
                    modeloCola.addRow(new Object[]{p.pid, p.nombre, p.tiempoCPU, p.instanteLlegada, quantumDisplay});
                }
            });
        }

        // Actualiza la tabla de historial con los procesos que ya terminaron y su tiempo ejecutado
        private void actualizarTablaHistorial(List<Proceso> hist) {
            SwingUtilities.invokeLater(() -> {
                modeloHistorial.setRowCount(0);
                for(Proceso p: hist) {
                    modeloHistorial.addRow(new Object[]{p.pid, p.nombre, p.tiempoEjecutado});
                }
            });
        }
    }

    // Clase Proceso que representa un proceso con sus características y estados
    private class Proceso {
        int pid; // Identificador único del proceso
        String nombre; // Nombre del proceso
        int tiempoCPU; // Tiempo total requerido para ejecución en CPU
        int instanteLlegada; // Tiempo en el que llega a la cola de listos
        int quantum; // Quantum para Round Robin (0 si no aplica)
        int tiempoEjecutado; // Tiempo que ha sido ejecutado hasta ahora
        int tiempoFinalizacion = -1; // Tiempo en que el proceso finalizó
        int tiempoRetorno = -1; // Tiempo retorno (finalización - llegada)
        int tiempoEspera = -1; // Tiempo de espera en cola (retorno - CPU)

        // Constructor para crear un nuevo proceso con datos iniciales
        public Proceso(int pid, String nombre, int tiempoCPU, int instanteLlegada, int quantum) {
            this.pid = pid;
            this.nombre = nombre;
            this.tiempoCPU = tiempoCPU;
            this.instanteLlegada = instanteLlegada;
            this.quantum = quantum;
            this.tiempoEjecutado = 0;
        }

        // Constructor copia para simular sin modificar los datos originales
        public Proceso(Proceso p) {
            this.pid = p.pid;
            this.nombre = p.nombre;
            this.tiempoCPU = p.tiempoCPU;
            this.instanteLlegada = p.instanteLlegada;
            this.quantum = p.quantum;
            this.tiempoEjecutado = 0; 
            this.tiempoFinalizacion = -1;
            this.tiempoRetorno = -1; 
            this.tiempoEspera = -1; 
        }
    }

